FUNCTION main :
READ t1
n := t1
IF n > #0 GOTO label1
GOTO label2
LABEL label1 :
t2 := #1
WRITE t2
GOTO label3
LABEL label2 :
IF n < #0 GOTO label4
GOTO label5
LABEL label4 :
t5 := #1
t4 := #0 - t5
WRITE t4
GOTO label6
LABEL label5 :
t7 := #0
WRITE t7
LABEL label6 :
LABEL label3 :
t9 := #0
RETURN t9
